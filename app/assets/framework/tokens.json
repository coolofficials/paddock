    "comfortable": {
      "control": "36px",
      "row": "48px"
    },
    "compact": {
      "control": "32px",
      "row": "40px"
    }
  },
  "motion": {
    "fast": "100ms",
    "normal": "160ms",
    "enter": "200ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "policy": {
    "accentChanges": "versioned theme only",
    "essentialTextContrast": 4.5,
    "functionalNonTextContrast": 3,
    "pointerTarget": "32px desktop; 44px coarse pointer",
    "minimumEssentialFont": "0.9375rem",
    "qualityGates": "quality-gates.json",
    "releaseGate": "static, browser and manual evidence required; pending is not passed",
    "reducedMotion": "no positional animation; immediate state changes",
    "defaultTheme": "system",
    "defaultDensity": "comfortable"
  }
